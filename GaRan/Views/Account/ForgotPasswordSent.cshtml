@{
    ViewData["Title"] = "Kiểm tra email";
}
<div class="container section-pad auth-page">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="auth-panel">
                <h1>Kiểm tra email</h1>
                @if (ViewBag.DeliveryFailed == true)
                {
                    <div class="alert alert-danger" role="alert">
                        Chưa gửi được mã xác nhận. Bạn thử lại sau ít phút; nếu vẫn lỗi, hãy báo quản trị viên kiểm tra cấu hình email (SMTP).
                    </div>
                }
                else
                {
                    <p>Nếu email khớp với tài khoản đang hoạt động, mã xác nhận sẽ được gửi và có hiệu lực trong 15 phút. Hãy kiểm tra cả thư mục Spam/Thư rác.</p>
                }
                <a asp-action="ResetPassword" class="btn btn-primary w-100">Nhập mã và đặt mật khẩu mới</a>
                <a asp-action="ForgotPassword" class="btn btn-link w-100 mt-1">Gửi lại mã</a>
                <a asp-action="Login" class="btn btn-link w-100 mt-2">Quay lại đăng nhập</a>
            </div>
        </div>
    </div>
</div>
