@model LoginVM
@{
    ViewData["Title"] = "Đăng nhập Admin";
    Layout = "_InternalLayout";
}

<main class="internal-auth-shell admin-auth-shell">
    <section class="internal-auth-card">
        <div class="internal-auth-visual admin-auth-visual">
            <a class="internal-brand-lockup" asp-action="StaffLogin"><span class="internal-mascot">🐔</span><span><strong>GaRan</strong><small>Admin Panel</small></span></a>
            <div class="internal-visual-copy"><span class="internal-overline">CHÀO MỪNG ĐẾN VỚI</span><h1>Trung tâm<br /><em>quản trị</em><br />GaRan.</h1><p>Vận hành cửa hàng hiệu quả, chăm sóc khách hàng và phát triển thương hiệu cùng GaRan.</p></div>
            <div class="internal-feature-list"><span><b>✓</b> Quản lý đơn hàng và giao nhận</span><span><b>✓</b> Theo dõi doanh thu, khách hàng</span><span><b>✓</b> Quản lý thực đơn và nhân viên</span></div>
            <div class="internal-food-art" aria-hidden="true"><span>🍗</span><span>🍟</span><span>🥤</span></div>
            <div class="internal-visual-note">Good Food · Good Mood!</div>
        </div>
        <div class="internal-auth-form-pane">
            <div class="internal-auth-badge">🛡 CHỈ DÀNH CHO QUẢN TRỊ VIÊN</div>
            <div class="internal-form-logo">🐔</div>
            <h2>Đăng nhập Admin</h2>
            <p class="internal-form-subtitle">Đăng nhập để tiếp tục vào hệ thống quản trị GaRan.</p>
            <form asp-action="AdminLogin" method="post" class="internal-login-form">
                <div asp-validation-summary="ModelOnly" class="internal-validation-summary"></div>
                <label asp-for="UsernameOrEmail">Tài khoản quản trị</label>
                <div class="internal-input-wrap"><span aria-hidden="true">♙</span><input asp-for="UsernameOrEmail" autocomplete="username" placeholder="Nhập tài khoản hoặc email" /></div>
                <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                <label asp-for="Password">Mật khẩu</label>
                <div class="internal-input-wrap"><span aria-hidden="true">▣</span><input asp-for="Password" autocomplete="current-password" placeholder="Nhập mật khẩu" /></div>
                <span asp-validation-for="Password" class="text-danger small"></span>
                <button type="submit" class="internal-submit-button"><span>↪</span> Đăng nhập quản trị</button>
            </form>
            <div class="internal-auth-help"><a asp-action="EmployeeLogin">Đăng nhập khu vực nhân viên</a><strong>@await Component.InvokeAsync("StoreContact")</strong></div>
            <div class="internal-auth-footnote">🔰 GaRan Admin Panel · Bảo mật · Ổn định · Hiệu quả</div>
        </div>
    </section>
</main>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
