@model DonHang
@{
    ViewData["Title"] = "Đơn hàng #" + Model.DonHangID;
    var payment = Model.ThanhToans.FirstOrDefault();
    var isPaid = payment?.TrangThaiThanhToan == "Đã thanh toán";
    var isAwaitingBankTransfer = payment?.TrangThaiThanhToan == "Đang chờ thanh toán" && payment.PhuongThucThanhToan is "QR" or "Bank";
    var reviewedProductIds = ViewBag.ProductReviewSubmittedIds as List<int> ?? new();
}
<div class="container section-pad receipt-page order-confirmation-page">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success no-print">@TempData["Message"]</div>
    }
    <div class="receipt-actions no-print">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Order" asp-action="Index" class="btn btn-outline-secondary">Đơn hàng của tôi</a>
        }
        else
        {
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Về trang chủ</a>
        }
    </div>

    <div class="row g-4 screen-only">
        <div class="col-lg-7">
            <section class="food-card p-4 h-auto mb-4">
                <div class="d-flex flex-wrap justify-content-between gap-2 align-items-start">
                    <div>
                        <h1 class="h3 fw-bold mb-2">Đơn hàng #@Model.DonHangID</h1>
                        <div class="text-muted">Đặt lúc: @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <span class="badge bg-warning text-dark">@Model.TrangThaiDonHang</span>
                </div>
                <hr />
                <h2 class="h5 fw-bold">@(ViewBag.StoreName ?? "GaRan")</h2>
                <div>@ViewBag.StoreAddress</div>
                <div class="text-muted">@ViewBag.StorePhone</div>
                <div class="table-responsive mt-4">
                    <table class="table align-middle order-screen-table">
                        <thead><tr><th>Món</th><th class="text-center">Số lượng</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th>@if (User.IsInRole("KhachHang") && Model.TrangThaiDonHang == "Hoàn thành") { <th>Đánh giá</th> }</tr></thead>
                        <tbody>
                        @foreach (var line in Model.ChiTietDonHangs)
                        {
                            <tr>
                                <td>@line.MonAn?.TenMon</td><td class="text-center">@line.SoLuong</td><td class="text-end">@line.DonGia.ToString("N0") đ</td><td class="text-end">@line.ThanhTien.ToString("N0") đ</td>
                                @if (User.IsInRole("KhachHang") && Model.TrangThaiDonHang == "Hoàn thành")
                                {
                                    <td>
                                        @if (reviewedProductIds.Contains(line.MonAnID))
                                        {
                                            <span class="small text-success">Đã gửi</span>
                                        }
                                        else
                                        {
                                            <details class="order-review-details"><summary>Viết đánh giá</summary>
                                                <form asp-controller="Review" asp-action="Create" method="post" class="order-review-form">
                                                    <input type="hidden" name="monAnId" value="@line.MonAnID" /><input type="hidden" name="donHangId" value="@Model.DonHangID" />
                                                    <label class="form-label small mb-1">Số sao</label><select name="soSao" class="form-select form-select-sm mb-2"><option value="5">5 sao</option><option value="4">4 sao</option><option value="3">3 sao</option><option value="2">2 sao</option><option value="1">1 sao</option></select>
                                                    <textarea name="noiDung" class="form-control form-control-sm mb-2" maxlength="500"></textarea>
                                                    <button class="btn btn-sm btn-warning" type="submit">Gửi đánh giá</button>
                                                </form>
                                            </details>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
        <div class="col-lg-5">
            <section class="food-card p-4 h-auto mb-4 order-screen-summary">
                <h2 class="h5 fw-bold">Thông tin đơn hàng</h2>
                <div><strong>Khách:</strong> @(Model.TenKhachDat ?? Model.KhachHang?.HoTen ?? "-")</div>
                <div><strong>Email:</strong> @(Model.EmailKhachDat ?? Model.KhachHang?.Email ?? "-")</div>
                <div><strong>Địa chỉ:</strong> @Model.DiaChiGiaoHang</div>
                <div><strong>Điện thoại:</strong> @Model.SoDienThoaiNhan</div>
                @if (!string.IsNullOrWhiteSpace(Model.GhiChu)) { <div class="mt-2"><strong>Ghi chú đơn hàng:</strong> @Model.GhiChu</div> }
                <hr />
                <div class="order-screen-total">@Model.TongTien.ToString("N0") đ</div>
                @if (Model.TienGiamThanhVien > 0) { <div class="small text-success">Ưu đãi thành viên VIP: -@Model.TienGiamThanhVien.ToString("N0") đ</div> }
                <div class="small text-muted">Tiền hàng @Model.TienHang.ToString("N0") đ · Thuế @Model.TienThue.ToString("N0") đ · Giao hàng @Model.PhiGiaoHang.ToString("N0") đ</div>
                <div class="mt-2"><strong>Phương thức:</strong> @(payment?.PhuongThucThanhToan switch { "COD" => "Thanh toán khi nhận hàng (COD)", "QR" => "Thanh toán QR", "Bank" => "Chuyển khoản ngân hàng", _ => "Chưa xác định" })</div>
                <div><strong>Thanh toán:</strong> <span id="paymentStatus" data-pending="@(isAwaitingBankTransfer ? "true" : "false")" data-url="@Url.Action("PaymentStatus", "Order", new { id = Model.DonHangID })">@(payment?.TrangThaiThanhToan ?? "Chưa thanh toán")</span></div>

                @if (payment?.PhuongThucThanhToan is "QR" or "Bank")
                {
                    var bankBin = ViewBag.BankBin as string ?? string.Empty;
                    var bankAccount = ViewBag.BankAccount as string ?? string.Empty;
                    var bankOwner = ViewBag.BankOwner as string ?? string.Empty;
                    var transferNote = payment.MaGiaoDich ?? $"WOCORDER{Model.DonHangID}";
                    if (ViewBag.PayOsConfigured is not true && !string.IsNullOrWhiteSpace(bankBin) && !string.IsNullOrWhiteSpace(bankAccount))
                    {
                        var amount = Model.TongTien.ToString("0", System.Globalization.CultureInfo.InvariantCulture);
                        var qrUrl = $"https://img.vietqr.io/image/{Uri.EscapeDataString(bankBin)}-{Uri.EscapeDataString(bankAccount)}-compact2.png?amount={amount}&addInfo={Uri.EscapeDataString(transferNote)}&accountName={Uri.EscapeDataString(bankOwner)}";
                        <div class="order-screen-qr">
                            <h3 class="h6 fw-bold">Mã QR chuyển khoản ngân hàng</h3>
                            <img src="@qrUrl" alt="QR thanh toán đơn hàng #@Model.DonHangID" class="bank-qr-image" />
                            <div class="order-bank-info">
                                <div>Ngân hàng: <strong>@ViewBag.BankName</strong></div>
                                <div>Tên tài khoản: <strong>@bankOwner</strong></div>
                                <div>Số tài khoản: <strong>@bankAccount</strong></div>
                                <div>Số tiền: <strong>@Model.TongTien.ToString("N0") đ</strong></div>
                                <div>Nội dung: <strong>@transferNote</strong></div>
                            </div>
                        </div>
                    }
                    else if (ViewBag.PayOsConfigured is not true)
                    {
                        <div class="alert alert-warning mt-3 mb-0">Chưa cấu hình tài khoản ngân hàng để tạo QR.</div>
                    }
                }
                @if (!isPaid && payment != null)
                {
                    @if (isAwaitingBankTransfer)
                    {
                        @if (ViewBag.PayOsConfigured is true && (User.IsInRole("KhachHang") || User.Identity?.IsAuthenticated != true))
                        {
                            <form asp-controller="Payment" asp-action="PayOsCheckout" method="post" class="no-print mt-3">
                                <input type="hidden" name="orderId" value="@Model.DonHangID" />
                                <button type="submit" class="btn btn-primary w-100">@(string.IsNullOrWhiteSpace(payment.PayOsCheckoutUrl) ? "Thanh toán an toàn qua payOS" : "Tiếp tục thanh toán qua payOS")</button>
                            </form>
                        }
                    }
                    else if (payment.PhuongThucThanhToan == "COD")
                    {
                    }
                }
            </section>
            @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
            {
                <section class="food-card p-4 h-auto no-print">
                    <h2 class="h5">Quản lý trạng thái đơn</h2>
                    @if (Model.TrangThaiDonHang is "Hoàn thành" or "Đã hủy")
                    {
                    }
                    else
                    {
                        <form asp-action="ChangeStatus" method="post" class="d-flex gap-2 mt-3">
                            <input type="hidden" name="id" value="@Model.DonHangID" />
                            <select name="status" class="form-select">
                                @foreach (var status in new[] { "Chờ xác nhận", "Đã xác nhận", "Đang chế biến", "Chờ giao hàng", "Đang giao", "Hoàn thành", "Đã hủy" })
                                {
                                    <option value="@status" selected="@(status == Model.TrangThaiDonHang)">@status</option>
                                }
                            </select>
                            <button class="btn btn-primary">Lưu trạng thái</button>
                        </form>
                    }
                </section>
            }
            else if (User.IsInRole("KhachHang") && !isPaid && payment != null)
            {
                <section class="food-card p-4 h-auto no-print">
                    <h2 class="h5">Đổi phương thức thanh toán</h2>
                    <form asp-controller="Payment" asp-action="Pay" method="post" class="d-flex gap-2 mt-3">
                        <input type="hidden" name="orderId" value="@Model.DonHangID" />
                        <select name="method" class="form-select">
                            <option value="COD" selected="@(payment.PhuongThucThanhToan == "COD")">Tiền mặt khi nhận hàng (COD)</option>
                            <option value="QR" selected="@(payment.PhuongThucThanhToan == "QR")">Thanh toán QR</option>
                            <option value="Bank" selected="@(payment.PhuongThucThanhToan == "Bank")">Chuyển khoản ngân hàng</option>
                        </select>
                        <button class="btn btn-warning">Cập nhật</button>
                    </form>
                </section>
            }
        </div>
    </div>
    @if (Model.TrangThaiDonHang == "Chờ xác nhận" && !isPaid && (User.IsInRole("KhachHang") || Context.Session.GetInt32("ORDER_CONFIRMATION_ID") == Model.DonHangID))
    {
        <form asp-controller="Order" asp-action="Cancel" method="post" class="no-print mt-3" onsubmit="return confirm('Bạn muốn hủy đơn hàng này?');">
            <input type="hidden" name="id" value="@Model.DonHangID" />
            <button type="submit" class="btn btn-outline-danger">Hủy đơn hàng</button>
        </form>
    }
    @if (User.IsInRole("KhachHang") && Model.TrangThaiDonHang == "Hoàn thành")
    {
        <section class="food-card p-4 h-auto screen-only no-print mt-4">
            <h2 class="h5 fw-bold">Đánh giá dịch vụ</h2>
            @if (ViewBag.ServiceReviewSubmitted is true)
            {
                <div class="text-success">Bạn đã gửi đánh giá dịch vụ cho đơn hàng này.</div>
            }
            else
            {
                <form asp-controller="Review" asp-action="CreateService" method="post" class="row g-2">
                    <input type="hidden" name="donHangId" value="@Model.DonHangID" />
                    <div class="col-md-2"><label class="form-label" for="serviceRating">Số sao</label><select class="form-select" id="serviceRating" name="soSao"><option value="5">5 sao</option><option value="4">4 sao</option><option value="3">3 sao</option><option value="2">2 sao</option><option value="1">1 sao</option></select></div>
                    <div class="col-md-8"><label class="form-label" for="serviceReviewText">Nhận xét</label><input class="form-control" id="serviceReviewText" name="noiDung" maxlength="500" /></div>
                    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-warning w-100">Gửi đánh giá</button></div>
                </form>
            }
        </section>
    }
</div>
@section Scripts {
    <script>
        (() => {
            const status = document.getElementById('paymentStatus');
            if (!status || status.dataset.pending !== 'true') return;
            const check = async () => {
                try {
                    const response = await fetch(status.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!response.ok) return;
                    const payment = await response.json();
                    status.textContent = payment.status;
                    if (payment.paid) {
                        status.dataset.pending = 'false';
                        const message = document.getElementById('paymentWaitingMessage');
                        if (message) message.textContent = 'Đã nhận được thanh toán. Cửa hàng đang xử lý đơn hàng.';
                        window.clearInterval(timer);
                    }
                } catch { /* Retry on the next interval while the order page is open. */ }
            };
            const timer = window.setInterval(check, 5000);
            check();
        })();
    </script>
}
