@model List<KhuyenMai>
@{
    ViewData["Title"] = "Quản lý khuyến mãi";
    var today = DateTime.Today;
    var running = Model.Count(x => x.TrangThai && x.NgayBatDau.Date <= today && x.NgayKetThuc.Date >= today);
    var scheduled = Model.Count(x => x.TrangThai && x.NgayBatDau.Date > today);
    var ended = Model.Count(x => !x.TrangThai || x.NgayKetThuc.Date < today);
}

<section class="admin-page-heading"><div class="admin-page-title-icon">％</div><div><h2>Khuyến mãi</h2><p>Quản lý mã giảm giá và chương trình ưu đãi</p></div><a asp-action="Create" class="btn admin-primary-action">＋ Tạo khuyến mãi</a></section>
<div class="admin-summary-strip"><article><span class="admin-summary-icon">✦</span><div><small>Tổng chương trình</small><strong>@Model.Count</strong></div></article><article><span class="admin-summary-icon is-green">●</span><div><small>Đang diễn ra</small><strong>@running</strong></div></article><article><span class="admin-summary-icon is-blue">◷</span><div><small>Sắp diễn ra</small><strong>@scheduled</strong></div></article><article><span class="admin-summary-icon is-gray">✓</span><div><small>Đã kết thúc / tắt</small><strong>@ended</strong></div></article></div>
<div class="admin-filter-card admin-filter-grid"><div class="admin-search-field"><span>⌕</span><input id="promotionSearch" class="form-control admin-local-search" type="search" placeholder="Tìm mã hoặc tên chương trình..." /></div><select id="promotionStatus" class="form-select" data-admin-filter="status"><option value="">Tất cả trạng thái</option><option value="running">Đang diễn ra</option><option value="scheduled">Sắp diễn ra</option><option value="ended">Đã kết thúc / tắt</option></select><button class="btn admin-outline-action" type="button" onclick="document.getElementById('promotionSearch').value='';document.getElementById('promotionStatus').value='';document.querySelectorAll('[data-admin-search-row]').forEach(x=>x.hidden=false)">Làm mới</button></div>
<section class="admin-data-card"><div class="admin-data-card-heading"><div><strong>Chương trình khuyến mãi</strong><span>Thời hạn được đối chiếu với ngày hiện tại</span></div><span class="admin-record-count">@Model.Count chương trình</span></div>
    @if (!Model.Any()){<div class="admin-empty">Chưa có khuyến mãi nào.</div>}
    else {<div class="table-responsive"><table class="table admin-data-table align-middle"><thead><tr><th>Mã ưu đãi</th><th>Chương trình</th><th>Mức giảm</th><th>Thời gian áp dụng</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
    @foreach (var item in Model){var state = !item.TrangThai || item.NgayKetThuc.Date < today ? "ended" : item.NgayBatDau.Date > today ? "scheduled" : "running";var stateLabel = state switch { "running" => "Đang diễn ra", "scheduled" => "Sắp diễn ra", _ => "Đã kết thúc / tắt" };<tr data-admin-search-row data-status="@state"><td><span class="admin-coupon-code">@item.MaKhuyenMai</span></td><td><strong class="admin-cell-title">@item.TenKhuyenMai</strong></td><td><span class="admin-discount-value">@item.PhanTramGiam%</span></td><td>@item.NgayBatDau.ToString("dd/MM/yyyy") <span class="admin-muted">→</span> @item.NgayKetThuc.ToString("dd/MM/yyyy")</td><td><span class="admin-status-tag @(state == "running" ? "is-active" : state == "scheduled" ? "is-pending" : "is-inactive")">@stateLabel</span></td><td class="text-end"><div class="admin-row-actions"><a asp-action="Edit" asp-route-id="@item.KhuyenMaiID" class="admin-icon-action" aria-label="Sửa @item.TenKhuyenMai" title="Sửa">✎</a><form asp-action="Delete" method="post" onsubmit="return confirm('Xóa khuyến mãi này? Nếu mã đã được dùng, hệ thống sẽ chuyển sang ngừng áp dụng.');"><input type="hidden" name="id" value="@item.KhuyenMaiID" /><button class="admin-icon-action is-danger" aria-label="Xóa @item.TenKhuyenMai" title="Xóa">♲</button></form></div></td></tr>}
    </tbody></table></div><div class="admin-table-footer"><span>@Model.Count chương trình ưu đãi</span></div>}
</section>
