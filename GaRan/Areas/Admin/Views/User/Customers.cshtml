@model List<KhachHangTiemNangVM>
@{
    ViewData["Title"] = "Khách hàng";
    var activeCount = Model.Count(x => x.KhachHang.TrangThai);
    var vipCount = Model.Count(x => x.LaThanhVienVip);
    var newCount = Model.Count(x => x.KhachHang.NgayTao.Month == DateTime.Today.Month && x.KhachHang.NgayTao.Year == DateTime.Today.Year);
    var totalSpend = Model.Sum(x => x.TongChiTieu);
}

<section class="admin-page-heading"><div class="admin-page-title-icon is-pink">♙</div><div><h2>Khách hàng</h2><p>Quản lý hồ sơ và lịch sử mua hàng của khách hàng</p></div><a asp-action="Index" class="btn admin-outline-action">Tài khoản nội bộ</a></section>
<div class="admin-summary-strip"><article><span class="admin-summary-icon is-blue">♙</span><div><small>Tổng khách hàng</small><strong>@Model.Count</strong></div></article><article><span class="admin-summary-icon is-green">＋</span><div><small>Khách mới tháng này</small><strong>@newCount</strong></div></article><article><span class="admin-summary-icon is-purple">↻</span><div><small>Đang hoạt động</small><strong>@activeCount</strong></div></article><article><span class="admin-summary-icon is-gold">★</span><div><small>Thành viên VIP</small><strong>@vipCount</strong></div></article></div>
<div class="admin-filter-card admin-filter-grid"><div class="admin-search-field"><span>⌕</span><input id="customerSearch" class="form-control admin-local-search" type="search" placeholder="Tìm tên, email hoặc số điện thoại..." /></div><select id="customerStatus" class="form-select" data-admin-filter="status"><option value="">Tất cả trạng thái</option><option value="active">Hoạt động</option><option value="inactive">Đã khóa</option></select><button class="btn admin-outline-action" type="button" onclick="document.getElementById('customerSearch').value='';document.getElementById('customerStatus').value='';document.querySelectorAll('[data-admin-search-row]').forEach(x=>x.hidden=false)">Làm mới</button></div>
<section class="admin-data-card"><div class="admin-data-card-heading"><div><strong>Danh sách khách hàng</strong><span>Tổng chi tiêu hoàn thành: <b class="admin-money">@totalSpend.ToString("N0") đ</b></span></div><span class="admin-record-count">@Model.Count khách</span></div>
    @if (!Model.Any()){<div class="admin-empty">Chưa có khách hàng nào.</div>}
    else {<div class="table-responsive"><table class="table admin-data-table align-middle"><thead><tr><th>Khách hàng</th><th>Liên hệ</th><th>Địa chỉ</th><th>Điểm</th><th>Hạng thành viên</th><th>Đơn hoàn thành</th><th>Tổng chi tiêu</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
    @foreach (var item in Model){var customer=item.KhachHang;<tr data-admin-search-row data-status="@(customer.TrangThai ? "active" : "inactive")"><td><div class="admin-person-cell"><span class="admin-person-avatar">@(string.IsNullOrWhiteSpace(customer.HoTen) ? "?" : customer.HoTen[..1].ToUpperInvariant())</span><div><strong>@customer.HoTen</strong><small>#KH@customer.KhachHangID</small></div></div></td><td><strong class="admin-cell-title">@customer.Email</strong><small class="admin-cell-subtitle">@customer.SoDienThoai</small></td><td class="admin-description-cell">@customer.DiaChi</td><td class="admin-points">@customer.DiemTichLuy</td><td>@if(item.LaThanhVienVip){<span class="admin-status-tag is-vip">★ VIP</span>}else{<span class="admin-status-tag is-member">Thành viên</span>}</td><td>@item.SoDonHoanThanh</td><td class="admin-money">@item.TongChiTieu.ToString("N0") đ</td><td><span class="admin-status-tag @(customer.TrangThai ? "is-active" : "is-inactive")">@(customer.TrangThai ? "Hoạt động" : "Đã khóa")</span></td><td class="text-end"><form asp-action="ToggleCustomerStatus" method="post" onsubmit="return confirm('@(customer.TrangThai ? "Khóa" : "Mở khóa") tài khoản @customer.Email?');"><input type="hidden" name="id" value="@customer.KhachHangID" /><button class="admin-icon-action @(customer.TrangThai ? "is-danger" : "")" aria-label="@(customer.TrangThai ? "Khóa" : "Mở khóa") @customer.HoTen" title="@(customer.TrangThai ? "Khóa" : "Mở khóa")">@(customer.TrangThai ? "⏻" : "✓")</button></form></td></tr>}
    </tbody></table></div><div class="admin-table-footer"><span>@Model.Count khách hàng · Sắp xếp theo tổng chi tiêu</span></div>}
</section>
