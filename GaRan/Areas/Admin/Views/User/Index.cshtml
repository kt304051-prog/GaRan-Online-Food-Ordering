@model List<NguoiDung>
@{
    ViewData["Title"] = "Quản lý nhân viên";
    var activeCount = Model.Count(x => x.TrangThai);
    var adminCount = Model.Count(x => x.VaiTro?.TenVaiTro == "Admin");
    var pausedCount = Model.Count - activeCount;
}

<section class="admin-page-heading"><div class="admin-page-title-icon">♟</div><div><h2>Quản lý nhân viên</h2><p>Quản lý tài khoản nội bộ, vai trò và trạng thái truy cập</p></div><a asp-action="Create" class="btn admin-primary-action">＋ Thêm nhân viên</a></section>
<div class="admin-summary-strip"><article><span class="admin-summary-icon">♟</span><div><small>Tổng tài khoản</small><strong>@Model.Count</strong></div></article><article><span class="admin-summary-icon is-green">●</span><div><small>Đang hoạt động</small><strong>@activeCount</strong></div></article><article><span class="admin-summary-icon is-gold">◷</span><div><small>Đã khóa</small><strong>@pausedCount</strong></div></article><article><span class="admin-summary-icon is-purple">♜</span><div><small>Quản trị viên</small><strong>@adminCount</strong></div></article></div>
<div class="admin-filter-card admin-filter-grid admin-staff-filter"><div class="admin-search-field"><span>⌕</span><input id="staffSearch" class="form-control admin-local-search" type="search" placeholder="Tìm tên, email, số điện thoại..." /></div><select id="staffRole" class="form-select" data-admin-filter="role"><option value="">Tất cả vai trò</option><option value="admin">Quản trị viên</option><option value="staff">Nhân viên</option></select><select id="staffStatus" class="form-select" data-admin-filter="status"><option value="">Tất cả trạng thái</option><option value="active">Đang hoạt động</option><option value="inactive">Đã khóa</option></select><label class="admin-date-filter">Từ ngày<input id="staffDateFrom" class="form-control" type="date" aria-label="Ngày tham gia từ" /></label><label class="admin-date-filter">Đến ngày<input id="staffDateTo" class="form-control" type="date" aria-label="Ngày tham gia đến" /></label><button class="btn admin-outline-action" type="button" onclick="document.getElementById('staffSearch').value='';document.getElementById('staffRole').value='';document.getElementById('staffStatus').value='';document.getElementById('staffDateFrom').value='';document.getElementById('staffDateTo').value='';document.querySelectorAll('[data-admin-search-row]').forEach(x=>x.hidden=false)">Làm mới</button></div>
<section class="admin-data-card"><div class="admin-data-card-heading"><div><strong>Tài khoản nhân viên</strong><span>Chỉ tài khoản quản trị nội bộ</span></div><a asp-action="Customers" class="admin-inline-link">Quản lý khách hàng →</a></div>
    @if (!Model.Any()){<div class="admin-empty">Chưa có tài khoản nội bộ nào.</div>}
    else {<div class="table-responsive"><table class="table admin-data-table align-middle"><thead><tr><th>Nhân viên</th><th>Tài khoản</th><th>Liên hệ</th><th>Vai trò</th><th>Trạng thái</th><th>Ngày tham gia</th><th class="text-end">Thao tác</th></tr></thead><tbody>
    @foreach (var item in Model){var role = item.VaiTro?.TenVaiTro == "Admin" ? "admin" : "staff";<tr data-admin-search-row data-role="@role" data-status="@(item.TrangThai ? "active" : "inactive")" data-created="@item.NgayTao.ToString("yyyy-MM-dd")"><td><div class="admin-person-cell"><span class="admin-person-avatar">@(string.IsNullOrWhiteSpace(item.HoTen) ? "?" : item.HoTen[..1].ToUpperInvariant())</span><strong>@item.HoTen</strong></div></td><td><span class="admin-soft-tag">@item.TenDangNhap</span></td><td><strong class="admin-cell-title">@item.Email</strong><small class="admin-cell-subtitle">@item.SoDienThoai</small></td><td><span class="admin-role-tag @(role == "admin" ? "is-admin" : "")">@(role == "admin" ? "♜ Quản trị viên" : "♟ Nhân viên")</span></td><td><span class="admin-status-tag @(item.TrangThai ? "is-active" : "is-inactive")">@(item.TrangThai ? "Đang hoạt động" : "Đã khóa")</span></td><td>@item.NgayTao.ToString("dd/MM/yyyy")</td><td class="text-end"><div class="admin-row-actions"><a asp-action="Edit" asp-route-id="@item.NguoiDungID" class="admin-icon-action" aria-label="Sửa @item.HoTen" title="Sửa">✎</a><form asp-action="Delete" method="post" onsubmit="return confirm('Khóa tài khoản này?');"><input type="hidden" name="id" value="@item.NguoiDungID" /><button class="admin-icon-action is-danger" aria-label="Khóa @item.HoTen" title="Khóa">⏻</button></form></div></td></tr>}
    </tbody></table></div><div class="admin-table-footer"><span>@Model.Count tài khoản nhân viên</span></div>}
</section>
