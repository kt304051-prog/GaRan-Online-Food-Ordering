@model DanhMuc
@{
    ViewData["Title"] = Model.DanhMucID == 0 ? "Thêm danh mục" : "Sửa danh mục";
}

<div class="admin-toolbar">
    <div>
        <h2>@ViewData["Title"]</h2>
    </div>
    <a asp-action="Index" class="btn btn-outline-primary">Quay lại</a>
</div>

<form asp-action="Save" method="post" class="admin-card p-4 admin-form-narrow">
    <input asp-for="DanhMucID" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="TenDanhMuc" class="form-label">Tên danh mục</label>
        <input asp-for="TenDanhMuc" class="form-control" />
        <span asp-validation-for="TenDanhMuc" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MoTa" class="form-label">Mô tả</label>
        <textarea asp-for="MoTa" rows="4" class="form-control"></textarea>
        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>
    <div class="form-check admin-check mb-4">
        <input asp-for="TrangThai" class="form-check-input" />
        <label asp-for="TrangThai" class="form-check-label">Đang hiển thị</label>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary">Lưu danh mục</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
