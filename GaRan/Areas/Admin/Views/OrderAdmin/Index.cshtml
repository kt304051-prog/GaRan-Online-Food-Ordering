@model List<DonHang>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var statuses = new[] { "Chờ xác nhận", "Đã xác nhận", "Đang chế biến", "Chờ giao hàng", "Đang giao", "Hoàn thành", "Đã hủy" };
    var pendingCount = Model.Count(x => x.TrangThaiDonHang is "Chờ xác nhận" or "Đã xác nhận");
    var deliveryCount = Model.Count(x => x.TrangThaiDonHang is "Chờ giao hàng" or "Đang giao");
    var completedCount = Model.Count(x => x.TrangThaiDonHang == "Hoàn thành");
    var selectedDate = (string?)ViewBag.SelectedDate;
}

<section class="admin-page-heading"><div class="admin-page-title-icon">🛒</div><div><h2>Quản lý đơn hàng</h2><p>Theo dõi và xử lý đơn hàng của cửa hàng</p></div><a asp-area="Admin" asp-controller="Invoice" asp-action="Index" class="btn admin-outline-action">Xem hóa đơn</a></section>
<div class="admin-summary-strip"><article><span class="admin-summary-icon is-red">▤</span><div><small>Đơn trong kết quả</small><strong>@Model.Count</strong></div></article><article><span class="admin-summary-icon is-gold">◷</span><div><small>Chờ xử lý</small><strong>@pendingCount</strong></div></article><article><span class="admin-summary-icon is-blue">♧</span><div><small>Đang giao / chờ giao</small><strong>@deliveryCount</strong></div></article><article><span class="admin-summary-icon is-green">✓</span><div><small>Hoàn thành</small><strong>@completedCount</strong></div></article></div>
<form class="admin-filter-card admin-order-filter-grid" method="get" asp-area="Admin" asp-controller="OrderAdmin" asp-action="Index" data-order-filters>
    <label><span>Ngày đặt hàng</span><input id="orderDate" name="date" type="date" class="form-control" value="@selectedDate" /></label>
    <label><span>Trạng thái</span><select id="orderStatus" name="status" class="form-select"><option value="">Tất cả trạng thái</option>@foreach(var s in statuses){<option value="@s" selected="@(ViewBag.Status == s)">@s</option>}</select></label>
    <a asp-action="Index" asp-route-date="@selectedDate" class="btn admin-outline-action">Xóa lọc</a>
</form>
<section class="admin-data-card"><div class="admin-data-card-heading"><div><strong>Danh sách đơn hàng</strong><span>Ngày @DateTime.Parse(selectedDate ?? DateTime.Today.ToString("yyyy-MM-dd")).ToString("dd/MM/yyyy") · thay đổi trạng thái ngay tại bảng</span></div><span class="admin-record-count">@Model.Count đơn</span></div>
    @if (!Model.Any()){<div class="admin-empty">Không có đơn hàng phù hợp trong ngày đã chọn.</div>}
    else {<div class="table-responsive"><table class="table admin-data-table admin-orders-table align-middle"><thead><tr><th>Đơn hàng</th><th>Khách hàng</th><th>Liên hệ</th><th>Địa chỉ giao</th><th>Chi phí</th><th>Thanh toán</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
    @foreach(var item in Model){var payment=item.ThanhToans.FirstOrDefault();var nextStatus=GaRan.Services.OrderStatusFlow.GetNextStatuses(item.TrangThaiDonHang).FirstOrDefault(s=>s!="Đã hủy");<tr data-admin-search-row><td><strong class="admin-order-number">#@item.DonHangID</strong><small class="admin-cell-subtitle">@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</small></td><td><strong class="admin-cell-title">@(item.TenKhachDat ?? item.KhachHang?.HoTen ?? "Khách vãng lai")</strong><small class="admin-cell-subtitle">@(item.NhanVien?.HoTen ?? "Đơn trực tuyến")</small></td><td><strong class="admin-cell-title">@item.SoDienThoaiNhan</strong><small class="admin-cell-subtitle">@(item.EmailKhachDat ?? item.KhachHang?.Email ?? "")</small></td><td class="admin-description-cell">@item.DiaChiGiaoHang<small class="admin-cell-subtitle">Khoảng cách @item.KhoangCachKm.ToString("0.00") km</small></td><td><strong class="admin-money">@item.TongTien.ToString("N0") đ</strong><small class="admin-cell-subtitle">Hàng @item.TienHang.ToString("N0") · thuế @item.TienThue.ToString("N0") · giao @item.PhiGiaoHang.ToString("N0")</small></td><td><strong class="admin-cell-title">@(payment?.PhuongThucThanhToan ?? "-")</strong><small class="admin-cell-subtitle">@(payment?.TrangThaiThanhToan ?? "Chưa thanh toán")</small></td><td><span class="admin-status-tag @(item.TrangThaiDonHang == "Hoàn thành" ? "is-active" : item.TrangThaiDonHang == "Đã hủy" ? "is-inactive" : item.TrangThaiDonHang == "Đang giao" ? "is-pending" : "is-blue")">@item.TrangThaiDonHang</span></td><td class="text-end"><div class="admin-order-actions"><a asp-action="Details" asp-route-id="@item.DonHangID" class="admin-small-action">Chi tiết</a>@if(nextStatus != null){var actionLabel=nextStatus switch{"Đã xác nhận"=>"Xác nhận","Đang chế biến"=>"Bắt đầu làm","Chờ giao hàng"=>"Sẵn sàng giao","Đang giao"=>"Bàn giao shipper","Hoàn thành"=>"Hoàn tất",_=>nextStatus};<form asp-action="ChangeStatus" method="post"><input type="hidden" name="id" value="@item.DonHangID"/><input type="hidden" name="returnDate" value="@selectedDate"/><input type="hidden" name="status" value="@nextStatus"/><button class="admin-small-action is-primary">@actionLabel</button></form>@if(item.TrangThaiDonHang is not ("Hoàn thành" or "Đã hủy")){<form asp-action="ChangeStatus" method="post" onsubmit="return confirm('Hủy đơn #@item.DonHangID?');"><input type="hidden" name="id" value="@item.DonHangID"/><input type="hidden" name="returnDate" value="@selectedDate"/><input type="hidden" name="status" value="Đã hủy"/><button class="admin-small-action is-danger">Hủy</button></form>}}</div></td></tr>}
    </tbody></table></div><div class="admin-table-footer"><span>Hiển thị @Model.Count đơn theo bộ lọc hiện tại</span></div>}
</section>
@section Scripts {<script>(()=>{const form=document.querySelector('[data-order-filters]');form?.querySelectorAll('input[name="date"],select[name="status"]').forEach(c=>c.addEventListener('change',()=>form.requestSubmit()));})();</script>}
