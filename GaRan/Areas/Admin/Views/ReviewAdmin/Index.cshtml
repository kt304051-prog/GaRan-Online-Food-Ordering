@model List<DanhGia>
@{
    ViewData["Title"] = "Quản lý đánh giá";
    var searchEmail = (string?)ViewBag.SearchEmail;
    var average = Model.Count == 0 ? 0 : Model.Average(x => x.SoSao);
    var pending = Model.Count(x => !x.TrangThai);
    var approved = Model.Count(x => x.TrangThai);
    var fiveStars = Model.Count(x => x.SoSao == 5);
    var lowRatings = Model.Count(x => x.SoSao <= 2);
}

<section class="admin-page-heading"><div class="admin-page-title-icon">★</div><div><h2>Quản lý đánh giá</h2><p>Xem phản hồi của khách hàng về món ăn và dịch vụ</p></div></section>
<div class="admin-summary-strip admin-review-stats"><article><span class="admin-summary-icon is-gold">★</span><div><small>Tổng đánh giá</small><strong>@Model.Count</strong></div></article><article><span class="admin-summary-icon is-gold">★★★★★</span><div><small>Điểm trung bình</small><strong>@average.ToString("0.0") <small>/ 5</small></strong></div></article><article><span class="admin-summary-icon is-green">✓</span><div><small>Đã duyệt</small><strong>@approved</strong></div></article><article><span class="admin-summary-icon is-blue">◷</span><div><small>Chờ duyệt</small><strong>@pending</strong></div></article><article><span class="admin-summary-icon is-red">!</span><div><small>Đánh giá 1–2 sao</small><strong>@lowRatings</strong></div></article></div>
<form asp-action="Index" method="get" class="admin-filter-card admin-review-filter"><div class="admin-search-field"><span>⌕</span><input id="review-email-search" class="admin-local-search" name="email" value="@searchEmail" type="search" placeholder="Tìm theo email khách hàng..." /></div><button class="btn admin-primary-action" type="submit">Tìm kiếm</button>@if(!string.IsNullOrWhiteSpace(searchEmail)){<a asp-action="Index" class="btn admin-outline-action">Xóa lọc</a>}</form>
<section class="admin-data-card"><div class="admin-data-card-heading"><div><strong>Đánh giá của khách hàng</strong><span>@(string.IsNullOrWhiteSpace(searchEmail) ? "Mới nhất trước" : $"Kết quả khớp email: {searchEmail}")</span></div><span class="admin-record-count">@Model.Count đánh giá</span></div>
    @if(!Model.Any()){<div class="admin-empty">Không tìm thấy đánh giá nào.</div>}
    else{<div class="table-responsive"><table class="table admin-data-table align-middle"><thead><tr><th>Khách hàng</th><th>Đánh giá</th><th>Loại / món</th><th>Số sao</th><th>Ngày gửi</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead><tbody>
    @foreach(var item in Model){<tr data-admin-search-row><td><div class="admin-person-cell"><span class="admin-person-avatar">@(string.IsNullOrWhiteSpace(item.KhachHang?.HoTen) ? "?" : item.KhachHang!.HoTen[..1].ToUpperInvariant())</span><div><strong>@(item.KhachHang?.HoTen ?? "Khách hàng")</strong><small>@item.KhachHang?.Email</small></div></div></td><td class="admin-review-content">@(string.IsNullOrWhiteSpace(item.NoiDung) ? "Khách không để lại nội dung." : item.NoiDung)</td><td><span class="admin-review-type">@(item.LoaiDanhGia == "DichVu" ? "Dịch vụ" : "Món ăn")</span><small class="admin-cell-subtitle">@(item.LoaiDanhGia == "DichVu" ? $"Đơn #{item.DonHangID}" : item.MonAn?.TenMon)</small></td><td><span class="admin-review-stars">@string.Concat(Enumerable.Repeat("★", item.SoSao))<span>@item.SoSao/5</span></span></td><td>@item.NgayDanhGia.ToString("dd/MM/yyyy")<small class="admin-cell-subtitle">@item.NgayDanhGia.ToString("HH:mm")</small></td><td><span class="admin-status-tag @(item.TrangThai ? "is-active" : "is-pending")">@(item.TrangThai ? "Đã duyệt" : "Chờ duyệt")</span></td><td class="text-end"><div class="admin-row-actions">@if(!item.TrangThai){<form asp-action="Approve" method="post"><input type="hidden" name="id" value="@item.DanhGiaID"/><button class="admin-small-action is-primary">Duyệt</button></form>}<form asp-action="Delete" method="post" onsubmit="return confirm('Xóa đánh giá của @item.KhachHang?.Email?');"><input type="hidden" name="id" value="@item.DanhGiaID"/><button class="admin-icon-action is-danger" aria-label="Xóa đánh giá" title="Xóa">♲</button></form></div></td></tr>}
    </tbody></table></div><div class="admin-table-footer"><span>@Model.Count đánh giá hiển thị</span></div>}
</section>
